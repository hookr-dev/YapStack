# SPDX-License-Identifier: AGPL-3.0-only
# YapStack self-host relay — copy to `.env` and fill in. ONE file configures the whole
# stack (server + postgres + minio). The relay makes ZERO outbound calls and has NO
# admin key by default: self-host is always the maximum tier (entitlements = AllowAll).

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
# The database owner the server connects as (runs migrations + serves). Every
# tenant-scoped table is FORCE ROW LEVEL SECURITY, so even this owner is subject to
# tenant isolation (migrations/0001_initial.sql). See docs/self-hosting.md for the
# hardened two-role split (migrate as owner, serve as the non-owner yapstack_app role).
POSTGRES_USER=yapstack
POSTGRES_PASSWORD=CHANGE-ME-postgres-owner-password
POSTGRES_DB=yapstack

# Password for the NON-OWNER `yapstack_app` role. This role is created at DB init and
# granted table privileges by the migrations; the RLS design relies on it existing so a
# hardened deployment can run the SERVING connection as a non-owner that can never
# bypass RLS (docs/self-hosting.md). Not used by the default single-role compose.
YAPSTACK_APP_PASSWORD=CHANGE-ME-yapstack_app-password

# ---------------------------------------------------------------------------
# Server secrets (CRYPTO_SPEC §3) — REQUIRED, never defaulted.
# ---------------------------------------------------------------------------
# HS256 signing secret for access/refresh JWTs. Use a long random value
# (e.g. `openssl rand -hex 32`).
JWT_SECRET=CHANGE-ME-to-a-long-random-secret
# Pepper for the login decoy-salt (CRYPTO_SPEC §3.2) so account existence is
# unobservable. Use a long random value (`openssl rand -hex 32`).
SERVER_PEPPER=CHANGE-ME-to-a-long-random-pepper

# Address the server binds inside its container.
YAPSTACK_BIND_ADDR=0.0.0.0:8080
# Host port the relay is published on.
YAPSTACK_HTTP_PORT=8080

# ---------------------------------------------------------------------------
# Object storage (MinIO) — holds ENCRYPTED audio + snapshot blobs. The relay only
# presigns URLs (pure local HMAC); bytes flow client<->MinIO directly, never through the
# relay. Audio and the R2 bootstrap snapshot both live here.
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=yapstack-minio
MINIO_ROOT_PASSWORD=CHANGE-ME-minio-root-password
MINIO_BUCKET=yapstack
# Endpoint the SERVER signs against (internal compose network).
MINIO_ENDPOINT=http://minio:9000
# Public endpoint the CLIENT connects to for presigned PUT/GET. For a real deployment,
# put MinIO behind your reverse proxy and set this to that public https URL.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
# Host ports MinIO is published on (S3 API + console).
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
